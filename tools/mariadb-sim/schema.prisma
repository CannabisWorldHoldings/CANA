// GENERATED PROVIDER CANDIDATE. Do not merge this provider flip into the live schema.
// Regenerate with: node tools/mariadb-sim/generate-schema.mjs
// PROVIDER PORTABILITY (migration lane audit, 2026-07-26).
//
// The provider below is the LOCAL TEST substrate (see DB_CLASSIFICATION in
// src/lib/db-config.mjs). The schema is deliberately kept free of `@db.` native
// types and enums so `prisma migrate diff` can emit DDL for sqlite, mysql
// (MariaDB) and postgresql from this one file with only the provider line
// swapped — that generation is exercised by tests/migration-court.test.mjs.
//
// Known provider differences that are DECISIONS AT CUTOVER, not silent drift
// (verified against generated DDL for all three providers):
//   1. String → VARCHAR(191) on MySQL/MariaDB. Long-content columns (
//      DemandCreditEntry.evidenceChain, Article.content, AuditLog.details,
//      StagingABCARetailer.rawJson, SiteObservation.summary/evidence/
//      uncertainty/preparedAction, Product/Brand/Deal.description,
//      Dispute.oldValue/newValue, LicenseEvidence.notes) MUST gain @db.Text
//      in the MariaDB schema or inserts >191 chars fail (STRICT mode P2000).
//      None of those columns is indexed, so no TEXT-prefix-index is needed;
//      every indexed/unique String here is short (uuid/hex/hostname/slug).
//   2. Float → DOUBLE. Money columns (DemandCreditEntry.amount,
//      MenuEntry.price) stay binary floats on every provider; the application
//      already does integer-cents arithmetic. Moving to Decimal(12,2) changes
//      the Prisma client's returned type and is a cross-lane app change.
//   3. DateTime → DATETIME(3)/TIMESTAMP(3): millisecond precision, which the
//      ledger hash chain REQUIRES (observedAt/expiresAt are hashed into
//      entryHash). Do not reduce the precision below (3).
//   4. NULLs in unique indexes are DISTINCT (ignored) on sqlite, MySQL/InnoDB
//      and postgres alike — @@unique([merchantId, eventIdentity]) depends on
//      that for NULL-identity money rows; see the model comment below.
//   5. MySQL utf8mb4_unicode_ci collation is case-INSENSITIVE; sqlite TEXT is
//      case-sensitive. Uniques on User.email / Brand.domain become stricter on
//      MariaDB — near-duplicate rows differing only by case must be resolved
//      before import.
//
// OWNER DECISION EXECUTED (2026-08-08, ADR-0001): the canonical CANA datastore
// is managed PostgreSQL + PostGIS. The migration-lane audit above remains the
// authoritative record of cross-provider differences; the canary in
// tests/migration-court.test.mjs now swaps FROM postgresql to prove sqlite and
// mysql DDL still generate from this one file. SQLite is demoted to a
// read-only rollback-snapshot format (DB_CLASSIFICATION in src/lib/db-config.mjs),
// exactly as that classification always demanded.
//
// COLUMN-WIDTH REVIEW EXECUTED FOR POSTGRESQL (2026-08-09). Difference (1) above is
// the VARCHAR(191) hazard, and it is MySQL-family ONLY. On PostgreSQL an unannotated
// `String` maps to unbounded `text`, so NONE of the long-form columns listed in (1)
// needs `@db.Text` — verified against the live database (every such column is
// data_type=text, character_maximum_length=NULL). tests/column-width-cutover-court
// .test.mjs now clears `postgresql` on that recorded finding and instead PROSCRIBES
// bounding these columns with `@db.VarChar`, which is the only way truncation could
// return here; the full review is docs/migration/SQLITE_TO_POSTGRES.md
// §"Column-width review (PostgreSQL)". The tripwire remains armed for any future flip
// to an unreviewed provider.
//
// DATABASE_URL -> pooled connection, used by the running application.
// DIRECT_URL   -> unpooled connection, used by `prisma migrate`/introspection.
datasource db {
  provider = "mysql"
  url        = env("DATABASE_URL")
}

generator client {
  provider        = "prisma-client-js"
  // postgresqlExtensions lets Prisma manage PostGIS declaratively rather than
  // relying on an out-of-band CREATE EXTENSION that migrations cannot see.
  // native: local dev/test/build machines. rhel-openssl-*: CloudLinux
  // (RHEL-family) shared hosting used by the Namecheap production target, which
  // now opens an outbound TLS connection to managed PostgreSQL instead of
  // reading a local database file.
  binaryTargets   = ["native", "rhel-openssl-3.0.x", "rhel-openssl-1.1.x", "debian-openssl-1.1.x"]
}

// Parent Holdings Organization
model Organization {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  brands    Brand[]
}

// Represents one of the 10 child companies/brands
model Brand {
  id              String           @id @default(uuid())
  name            String
  domain          String           @unique // Hostname used to match requests (e.g. orderweeddc.com, brand1.localhost)
  description     String? @db.Text
  logo            String? // Path or URL to brand logo
  themePrimary    String           @default("#0e9f5a") // CSS primary color code
  themeSecondary  String           @default("#0a7443")
  themeBg         String           @default("#f6faf7")
  themeSurface    String           @default("#ffffff")
  themeText       String           @default("#0d1f18")
  organizationId  String
  organization    Organization     @relation(fields: [organizationId], references: [id])
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  leads           LeadEvent[]
  menuSelections  BrandMenu[]
  loyaltyAccounts LoyaltyAccount[]
}

// User model for shared network-wide customer identity and administrative access
model User {
  id                String           @id @default(uuid())
  email             String           @unique
  password          String // Hashed password
  name              String?
  role              String           @default("CUSTOMER") // ADMIN, RETAILER_MANAGER, CUSTOMER
  managedRetailerId String?
  managedRetailer   Retailer?        @relation("RetailerManagers", fields: [managedRetailerId], references: [id], onDelete: SetNull)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  auditLogs         AuditLog[]
  loyaltyAccounts   LoyaltyAccount[]
  sessions          Session[]
}

// Retailer (Dispensary, Delivery service, or Brand)
model Retailer {
  id                 String                   @id @default(uuid())
  name               String
  type               String                   @default("delivery") // delivery, storefront, brand
  address            String
  city               String                   @default("Washington")
  state              String                   @default("DC")
  zip                String?
  lat                Float
  lng                Float
  phone              String?
  website            String?
  email              String?
  hours              String                   @default("10:00 AM - 8:00 PM")
  hoursSource        String                   @default("Retailer Submitted")
  isOpen             Boolean                  @default(true)
  licenseStatus      String                   @default("PENDING") // VERIFIED, PENDING, EXPIRED, UNVERIFIED
  licenseSource      String                   @default("DC ABCA Registry")
  licenseNumber      String?                  @unique
  lastLicenseCheck   DateTime?
  lastInfoCheck      DateTime?
  menuUpdatedAt      DateTime?
  dealUpdatedAt      DateTime?
  isSponsored        Boolean                  @default(false)
  dataStatus         String                   @default("AWAITING_VERIFICATION") // DEMONSTRATION_ONLY, AWAITING_VERIFICATION, VERIFIED_CURRENT, STALE, DISPUTED
  dataSource         String                   @default("Unspecified")
  sourceUrl          String?
  retrievedAt        DateTime?
  verifiedAt         DateTime?
  freshnessExpiresAt DateTime?
  confidence         Float?
  reviewedBy         String?
  isDemonstration    Boolean                  @default(false)
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt
  evidence           LicenseEvidence[]
  menus              MenuEntry[]
  deals              Deal[]
  leads              LeadEvent[]
  claims             ClaimRequest[]
  disputes           Dispute[]
  managers           User[]                   @relation("RetailerManagers")
  marketResolutions  MarketEntityResolution[]

  @@index([dataStatus, isDemonstration, freshnessExpiresAt])
  @@index([type])
  @@index([lastLicenseCheck])
}

model Session {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

// Pseudonymous rolling evidence for durable authentication throttling.
// Raw email addresses and network addresses are never stored here.
model AuthFailure {
  id            String   @id @default(uuid())
  accountDigest String
  clientDigest  String
  surface       String
  occurredAt    DateTime @default(now())
  expiresAt     DateTime

  @@index([accountDigest, occurredAt])
  @@index([clientDigest, occurredAt])
  @@index([expiresAt])
}

// Pseudonymous, expiring reservations for public write abuse controls.
// Raw network addresses, email addresses, license numbers, and corrections
// are never stored here.
model PublicSubmissionEvent {
  id            String   @id @default(uuid())
  clientDigest  String
  subjectDigest String
  surface       String
  occurredAt    DateTime @default(now())
  expiresAt     DateTime

  @@unique([surface, subjectDigest])
  @@index([surface, clientDigest, occurredAt])
  @@index([surface, occurredAt])
  @@index([expiresAt])
}

// Verification evidence submitted by a retailer or gathered by admins
model LicenseEvidence {
  id                 String    @id @default(uuid())
  retailerId         String
  retailer           Retailer  @relation(fields: [retailerId], references: [id], onDelete: Cascade)
  documentUrl        String
  verificationStatus String    @default("PENDING") // PENDING, APPROVED, REJECTED
  submittedAt        DateTime  @default(now())
  verifiedAt         DateTime?
  notes              String? @db.Text
  dataStatus         String    @default("AWAITING_VERIFICATION")
  dataSource         String    @default("Retailer submission")
  sourceUrl          String?
  retrievedAt        DateTime?
  freshnessExpiresAt DateTime?
  confidence         Float?
  reviewedBy         String?
  isDemonstration    Boolean   @default(false)

  @@index([verificationStatus, submittedAt])
}

// Request to claim a listing by a business owner
model ClaimRequest {
  id                    String    @id @default(uuid())
  retailerId            String
  retailer              Retailer  @relation(fields: [retailerId], references: [id], onDelete: Cascade)
  email                 String
  phone                 String
  requestedPasswordHash String?
  status                String    @default("PENDING") // PENDING, APPROVED, REJECTED
  reviewedAt            DateTime?
  reviewedBy            String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([status, email])
  @@index([status, createdAt])
}

// Master Global Product Database (Unified catalog)
model Product {
  id                 String      @id @default(uuid())
  name               String
  description        String? @db.Text
  category           String // flower, edibles, concentrates, accessories, etc.
  strainType         String? // sativa, indica, hybrid, cbd
  thcPercent         Float?
  cbdPercent         Float?
  image              String?
  dataStatus         String      @default("AWAITING_VERIFICATION")
  dataSource         String      @default("Unspecified")
  sourceUrl          String?
  retrievedAt        DateTime?
  verifiedAt         DateTime?
  freshnessExpiresAt DateTime?
  confidence         Float?
  reviewedBy         String?
  isDemonstration    Boolean     @default(false)
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt
  menuEntries        MenuEntry[]

  @@index([name])
}

// Menu Entry - Connects Products to Retailers with pricing
model MenuEntry {
  id                 String      @id @default(uuid())
  retailerId         String
  retailer           Retailer    @relation(fields: [retailerId], references: [id], onDelete: Cascade)
  productId          String
  product            Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  price              Float
  quantity           Int?
  inStock            Boolean     @default(true)
  dataStatus         String      @default("AWAITING_VERIFICATION")
  dataSource         String      @default("Unspecified")
  sourceUrl          String?
  retrievedAt        DateTime?
  verifiedAt         DateTime?
  freshnessExpiresAt DateTime?
  confidence         Float?
  reviewedBy         String?
  isDemonstration    Boolean     @default(false)
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt
  brandMenus         BrandMenu[]

  @@unique([retailerId, productId])
  @@index([retailerId, updatedAt])
}

// Join table to determine which products/menu items are visible on which Brand platform
model BrandMenu {
  id          String    @id @default(uuid())
  brandId     String
  brand       Brand     @relation(fields: [brandId], references: [id], onDelete: Cascade)
  menuEntryId String
  menuEntry   MenuEntry @relation(fields: [menuEntryId], references: [id], onDelete: Cascade)

  @@unique([brandId, menuEntryId])
}

// Retailer deals and promotions
model Deal {
  id                 String    @id @default(uuid())
  retailerId         String
  retailer           Retailer  @relation(fields: [retailerId], references: [id], onDelete: Cascade)
  title              String
  description        String? @db.Text
  discount           String? // e.g. "20% off", "$10 off"
  code               String? // promo code
  expiryDate         DateTime
  isActive           Boolean   @default(true)
  dataStatus         String    @default("AWAITING_VERIFICATION")
  dataSource         String    @default("Unspecified")
  sourceUrl          String?
  retrievedAt        DateTime?
  verifiedAt         DateTime?
  freshnessExpiresAt DateTime?
  confidence         Float?
  reviewedBy         String?
  isDemonstration    Boolean   @default(false)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([retailerId, createdAt])
}

// Analytics and Lead attribution events
model LeadEvent {
  id         String   @id @default(uuid())
  brandId    String
  brand      Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)
  retailerId String
  retailer   Retailer @relation(fields: [retailerId], references: [id], onDelete: Cascade)
  eventType  String // HANDOFF_CLICK, PHONE_CALL_CLICK, WEBSITE_CLICK, MENU_VIEW
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([retailerId, eventType, createdAt])
}

// System Audit Logs for security and release records
model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String // e.g. "APPROVE_RETAILER", "UPDATE_BRAND_THEME", "AI_PROVIDER_CALL"
  details   String @db.Text
  timestamp DateTime @default(now())

  @@index([timestamp])
}

// An administrator-captured, local evidence snapshot for the Site Brain.
// Captures are bounded and never imply that external search or analytics
// providers have been connected.
model SiteIntelligenceSnapshot {
  id                     String            @id @default(uuid())
  fingerprint            String
  schemaVersion          Int               @default(1)
  capturedById           String
  capturedAt             DateTime          @default(now())
  asOf                   DateTime
  routeInventoryHash     String
  localEvidenceStatus    String
  externalEvidenceStatus String
  observationCount       Int
  attentionCount         Int
  blockedCount           Int
  observations           SiteObservation[]

  @@index([capturedAt])
  @@index([fingerprint, capturedAt])
}

// One immutable finding inside a captured Site Brain snapshot.
model SiteObservation {
  id             String                   @id @default(uuid())
  snapshotId     String
  snapshot       SiteIntelligenceSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
  observationKey String
  plane          String
  state          String
  severity       String
  title          String
  summary        String @db.Text
  evidence       String @db.Text
  uncertainty    String @db.Text
  preparedAction String @db.Text
  authority      String
  quantity       Int?
  createdAt      DateTime                 @default(now())

  @@unique([snapshotId, observationKey])
  @@index([state, severity])
}

// Loyalty account mapping points earned per Brand/Company on the network
model LoyaltyAccount {
  id           String               @id @default(uuid())
  userId       String
  user         User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  brandId      String
  brand        Brand                @relation(fields: [brandId], references: [id], onDelete: Cascade)
  points       Int                  @default(0)
  tier         String               @default("BRONZE") // BRONZE, SILVER, GOLD
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  transactions LoyaltyTransaction[]

  @@unique([userId, brandId])
}

// History of points changes
model LoyaltyTransaction {
  id               String         @id @default(uuid())
  loyaltyAccountId String
  loyaltyAccount   LoyaltyAccount @relation(fields: [loyaltyAccountId], references: [id], onDelete: Cascade)
  pointsChanged    Int
  description      String @db.Text
  createdAt        DateTime       @default(now())
}

// CMS Educational Articles
model Article {
  id                 String    @id @default(uuid())
  title              String
  slug               String    @unique
  content            String @db.Text
  image              String?
  author             String    @default("Holding Editorial Staff")
  dataStatus         String    @default("AWAITING_VERIFICATION")
  dataSource         String    @default("Unspecified")
  sourceUrl          String?
  retrievedAt        DateTime?
  verifiedAt         DateTime?
  freshnessExpiresAt DateTime?
  confidence         Float?
  reviewedBy         String?
  isDemonstration    Boolean   @default(false)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}

// Contradictions and Corrections Dispute Queue
model Dispute {
  id          String   @id @default(uuid())
  retailerId  String
  retailer    Retailer @relation(fields: [retailerId], references: [id], onDelete: Cascade)
  filedBy     String // email/contact of submitter
  fieldName   String // e.g. "address", "phone", "hours", "licenseNumber"
  oldValue    String? @db.Text
  newValue    String @db.Text
  evidenceUrl String
  reason      String   @default("Legacy submission (reason not recorded)")
  status      String   @default("PENDING") // PENDING, RESOLVED, REJECTED
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([retailerId, status, fieldName])
  @@index([status, createdAt])
}

// Staging table for dry-run ingestion of DC ABCA Feed data
model StagingABCARetailer {
  id            String   @id @default(uuid())
  tradeName     String
  licenseNumber String   @unique
  address       String?
  status        String?
  rawJson       String? @db.Text // Store full CSV row as JSON string for review
  ingestedAt    DateTime @default(now())

  @@index([licenseNumber])
  @@index([status])
}

/// Demand Credit ledger — append-only, hash-chained.
///
/// Persists the M-005 merchant-owned-demand mechanism. Rows are NEVER updated
/// or deleted: balance is derived by summing the chain, so a mutation would
/// silently change history. `entryHash` binds `prevHash`, making any edit,
/// reorder, or truncation detectable by replaying the chain.
///
/// Deliberately NOT stored: any running balance column. A stored balance can
/// drift from the entries that justify it; a derived one cannot.
model DemandCreditEntry {
  /// Monotonic position in the chain. Unique per merchant, gapless.
  seq                  Int
  id                   String    @id @default(uuid())
  merchantId           String
  /// ISSUE | SPEND | REFUND | EXPIRE | ATTRIBUTION
  kind                 String
  /// Signed: ISSUE/REFUND positive, SPEND negative, ATTRIBUTION always 0.
  amount               Float
  /// Chain integrity.
  prevHash             String
  entryHash            String    @unique
  /// ISSUE: why these credits legitimately exist.
  authorizationRef     String?
  expiresAt            DateTime?
  /// SPEND: placement slot + the visible disclosure that must accompany it.
  placement            String?
  disclosureLabel      String?
  /// Recorded so a rank purchase can never be silently introduced later.
  affectsOrganicOrder  Boolean   @default(false)
  /// REFUND: which SPEND is being reversed, and why.
  originalSeq          Int?
  reason               String?
  /// ATTRIBUTION: the evidence that makes the action a fact rather than a claim.
  actionKind           String?
  evidenceChain        String? @db.Text
  evidenceChainSha256  String?
  observedAt           DateTime?
  placementSeq         Int?
  /// The inversion: the merchant keeps the customer relationship.
  relationshipOwner    String?
  exportableByMerchant Boolean   @default(false)
  recordedAt           DateTime  @default(now())

  /// CANONICAL EVENT IDENTITY. The stable fingerprint of the real-world event this
  /// row records, independent of transport, retry, key ordering or wall-clock
  /// jitter. Nullable because only ATTRIBUTION rows carry one — money rows are
  /// already serialized by the per-merchant seq.
  ///
  /// WHY A COLUMN AND NOT A LOOKUP. The application previously did
  /// find-then-insert, which is a check-then-act race: 50 simultaneous identical
  /// POSTs produced TWO committed rows because both requests read "no duplicate"
  /// before either wrote. Only the database can decide this, and only with a
  /// uniqueness constraint. An application-level guard cannot be made correct here
  /// no matter how carefully it is written.
  eventIdentity String?

  /// GRADED CONSUMER EVIDENCE. REQUEST_RECEIVED means only that a request arrived;
  /// it must never contribute to a merchant value figure. The grade is STORED
  /// rather than recomputed so a later report cannot quietly re-grade history.
  proofState       String?
  valueEligible    Boolean @default(false)
  /// Nonce of the interaction token, retained ONLY to refuse a replay. Not the
  /// token, and not a user identifier.
  interactionNonce String?
  /// Where the consumer was handed off to, when a handoff was verified.
  destination      String?

  @@unique([merchantId, seq])
  /// The constraint that actually enforces idempotency. Scoped to the merchant so a
  /// collision across merchants is impossible by construction, and a tenant cannot
  /// suppress another tenant's event by guessing its identity.
  @@unique([merchantId, eventIdentity])
  @@index([merchantId, kind])
  @@index([entryHash])
  @@index([eventIdentity])
  @@index([merchantId, interactionNonce])
  /// Ledger scans in chain order are seq-indexed already; export and ops
  /// queries scan by wall-clock time. Added in migration
  /// 20260726000100_ledger_recorded_at_index — the first post-baseline
  /// migration, so forward migration is exercised rather than asserted.
  @@index([merchantId, recordedAt])
}

// ============================================================================
// CANA GEO KERNEL — minimum primitives (Slice 1a)
//
// Design laws enforced here:
//  1. CANA owns canonical identity. A provider's ID is an ALIAS, never truth.
//  2. Nothing is true because a provider said so. Assertions live in GeoClaim
//     with source, freshness, confidence and an explicit UNKNOWN state.
//  3. Every entity is temporal (validFrom/validUntil) and carries provenance.
//
// Deliberately NOT built yet (later slices, see docs/geo/ROADMAP.md):
//  GeoCell state, feature store, routing cache, isochrones, simulation
//  tables. Interfaces exist; tables are not invented ahead of use.
//  (The Opportunity table originally deferred here landed 2026-08-09 with
//  the continuation kernel — its first real use, Track A ask slice.)
// ============================================================================

/// Canonical geographic entity. The CANA-owned identity for any place.
/// `geom` is real PostGIS geometry and is therefore Unsupported by Prisma
/// Client: it is written/read through the SQL helpers in
/// apps/web/src/lib/geo/geometry.mjs, never through the ORM. `lat`/`lng` are
/// kept as a portable, ORM-readable mirror and are the source for `geom`.
model GeoEntity {
  /// CANA_LOCATION_ID — sovereign identifier. Never a provider ID.
  id         String                                @id @default(uuid())
  kind       String                                @default("business") // business, neighborhood, jurisdiction, service_area, poi
  name       String
  /// Portable coordinate mirror. Canonical geometry lives in `geom`.
  lat        Float
  lng        Float
  /// PostGIS point, SRID 4326. Maintained from lat/lng by trigger-free
  /// explicit sync in the geo helpers so the two can never silently diverge.
  geom       Unsupported("geometry")?
  /// H3 index (resolution 9) for aggregation and privacy coarsening.
  h3R9       String?
  /// Optional link back to the operational record this entity represents.
  retailerId String?                               @unique

  // -- provenance / temporality (Omega-6) --
  source       String    @default("UNKNOWN")
  sourceUrl    String?
  observedAt   DateTime?
  validFrom    DateTime  @default(now())
  validUntil   DateTime?
  confidence   Float?
  /// UNKNOWN | HYPOTHESIS | SUPPORTED | VERIFIED | CONTRADICTED | STALE
  verification String    @default("UNKNOWN")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  aliases           GeoEntityAlias[]
  claims            GeoClaim[]
  marketResolutions MarketEntityResolution[]

  @@index([kind, verification])
  @@index([h3R9])
  @@index([validUntil])
}

/// External references to a canonical entity. Evidence and join keys only —
/// an alias never confers truth. Overture GERS, OSM, and provider IDs land here.
model GeoEntityAlias {
  id          String    @id @default(uuid())
  geoEntityId String
  /// overture_gers | osm | provider:<name> | partner:<system>
  namespace   String
  externalId  String
  observedAt  DateTime?
  confidence  Float?
  createdAt   DateTime  @default(now())

  geoEntity GeoEntity @relation(fields: [geoEntityId], references: [id], onDelete: Cascade)

  @@unique([namespace, externalId])
  @@index([geoEntityId])
}

/// An evidence-bound geographic assertion. The public map may only render
/// claims that pass the evidence threshold; everything else renders as UNKNOWN.
model GeoClaim {
  id                   String    @id @default(uuid())
  geoEntityId          String
  /// e.g. is_open, serves_area, located_at, licensed_in
  claimType            String
  claimValue           String
  source               String
  sourceUrl            String?
  observedAt           DateTime?
  freshnessExpiresAt   DateTime?
  confidence           Float?
  corroboratingSources Int       @default(0)
  contradictorySources Int       @default(0)
  /// UNKNOWN | HYPOTHESIS | SUPPORTED | VERIFIED | CONTRADICTED | REFUTED | STALE
  verification         String    @default("UNKNOWN")
  /// False blocks the claim from customer-facing surfaces regardless of score.
  decisionEligible     Boolean   @default(false)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  /// Optional bridge to the evidence-constitutional claim that justified this
  /// compatibility projection. Legacy GeoClaim rows remain valid without it.
  marketClaimId        String?   @unique
  /// Tenant authority that created this compatibility projection.
  projectionTenant     String?

  geoEntity   GeoEntity    @relation(fields: [geoEntityId], references: [id], onDelete: Cascade)
  marketClaim MarketClaim? @relation(fields: [marketClaimId], references: [id], onDelete: Restrict)

  @@index([geoEntityId, claimType])
  @@index([verification, decisionEligible])
  @@index([freshnessExpiresAt])
  @@index([projectionTenant, decisionEligible, freshnessExpiresAt], map: "GeoClaim_projectionTenant_eligibility_idx")
}

// ============================================================================
// REALITY COMPILER — evidence constitution (Phase B Slice 1)
//
// These append-only records preserve source bytes, parsed observations,
// deterministic identity decisions, versioned claims, and court events. The
// existing GeoClaim table remains the public-map compatibility projection.
// ============================================================================

/// Immutable receipt for one exact official-source response. Runtime product
/// paths never fetch this URL; an owner-run importer supplies the captured
/// bytes and the compiler binds every downstream record to their SHA-256.
model MarketSourceSnapshot {
  id               String    @id @default(uuid())
  sourceKey        String
  sourceUrl        String
  queryParameters  String @db.Text
  fetchedAt        DateTime
  sourceModifiedAt DateTime?
  payloadSha256    String
  payloadBytes     Int
  recordCount      Int
  schemaVersion    String
  payloadJson      String @db.Text
  /// COMPLETE | PARTIAL | UNKNOWN
  completeness     String    @default("UNKNOWN")
  createdAt        DateTime  @default(now())

  observations MarketObservation[]
  resolutions  MarketEntityResolution[]
  claims       MarketClaim[]
  compilations MarketCompilation[]

  @@unique([sourceKey, payloadSha256])
  @@index([sourceKey, fetchedAt])
  @@index([sourceModifiedAt])
}

/// Idempotency boundary between a globally reusable immutable snapshot and a
/// tenant-scoped compilation. A shared snapshot never implies another tenant
/// has compiled or accepted its claims.
model MarketCompilation {
  id         String   @id @default(uuid())
  tenant     String
  snapshotId String
  createdAt  DateTime @default(now())

  snapshot    MarketSourceSnapshot     @relation(fields: [snapshotId], references: [id], onDelete: Restrict)
  resolutions MarketEntityResolution[]
  claims      MarketClaim[]

  @@unique([tenant, snapshotId])
  @@index([snapshotId])
}

/// One normalized assertion extracted from an immutable source record. Raw
/// record identity and hash are retained so normalization never erases origin.
model MarketObservation {
  id                 String    @id @default(uuid())
  snapshotId         String
  sourceRecordId     String
  sourceRecordSha256 String
  fieldName          String
  rawValue           String? @db.Text
  normalizedValue    String? @db.Text
  observedAt         DateTime
  freshnessExpiresAt DateTime?
  confidence         Float?
  uncertaintyJson    String? @db.Text   @map("uncertainty")
  createdAt          DateTime  @default(now())

  snapshot      MarketSourceSnapshot  @relation(fields: [snapshotId], references: [id], onDelete: Restrict)
  claimEvidence MarketClaimEvidence[]

  @@unique([snapshotId, sourceRecordId, fieldName])
  @@index([sourceRecordId, fieldName])
  @@index([freshnessExpiresAt])
}

/// Deterministic identity-resolution decision. Ambiguity is preserved as a
/// review state with candidate IDs; it is never converted to an automatic link.
model MarketEntityResolution {
  id                   String   @id @default(uuid())
  snapshotId           String
  compilationId        String
  sourceRecordId       String
  sourceRecordSha256   String
  normalizedLicense    String?
  normalizedName       String?
  normalizedAddress    String?
  /// MATCH | REVIEW_REQUIRED | UNMATCHED | MALFORMED
  status               String
  reason               String
  candidateIds         String @db.Text
  normalizationVersion String
  retailerId           String?
  geoEntityId          String?
  createdAt            DateTime @default(now())

  snapshot    MarketSourceSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Restrict)
  compilation MarketCompilation    @relation(fields: [compilationId], references: [id], onDelete: Restrict)
  retailer    Retailer?            @relation(fields: [retailerId], references: [id], onDelete: Restrict)
  geoEntity   GeoEntity?           @relation(fields: [geoEntityId], references: [id], onDelete: Restrict)
  claims      MarketClaim[]

  @@unique([compilationId, sourceRecordId])
  @@index([snapshotId, sourceRecordId])
  @@index([normalizedLicense])
  @@index([status])
  @@index([retailerId])
  @@index([geoEntityId])
}

/// Versioned market claim. Contradictions create another record and court
/// event; neither observations nor prior claim versions are overwritten.
model MarketClaim {
  id                 String    @id @default(uuid())
  tenant             String
  claimKey           String
  claimType          String
  claimValue         String @db.Text
  version            Int
  resolutionId       String
  snapshotId         String
  compilationId      String
  supersedesClaimId  String?
  observedAt         DateTime
  freshnessExpiresAt DateTime?
  confidence         Float?
  uncertaintyJson    String? @db.Text   @map("uncertainty")
  /// UNKNOWN | SUPPORTED | VERIFIED | CONTRADICTED | REFUTED | STALE
  verification       String    @default("UNKNOWN")
  decisionEligible   Boolean   @default(false)
  createdAt          DateTime  @default(now())

  resolution            MarketEntityResolution     @relation(fields: [resolutionId], references: [id], onDelete: Restrict)
  snapshot              MarketSourceSnapshot       @relation(fields: [snapshotId], references: [id], onDelete: Restrict)
  compilation           MarketCompilation          @relation(fields: [compilationId], references: [id], onDelete: Restrict)
  supersedes            MarketClaim?               @relation("MarketClaimVersions", fields: [supersedesClaimId], references: [id], onDelete: Restrict)
  versions              MarketClaim[]              @relation("MarketClaimVersions")
  evidence              MarketClaimEvidence[]
  verificationEvents    MarketVerificationEvent[]
  geoClaim              GeoClaim?
  earlierContradictions MarketClaimContradiction[] @relation("EarlierContradictionClaim")
  laterContradictions   MarketClaimContradiction[] @relation("LaterContradictionClaim")

  @@unique([tenant, claimKey, version])
  @@index([tenant, claimType, decisionEligible])
  @@index([resolutionId, claimType])
  @@index([freshnessExpiresAt])
}

/// Explicit append-only conflict between two claim versions. The exact
/// observations on each side remain addressable even after either claim ages.
model MarketClaimContradiction {
  id                        String   @id @default(uuid())
  tenant                    String
  claimKey                  String
  earlierClaimId            String
  laterClaimId              String
  earlierObservationIdsJson String @db.Text   @map("earlierObservationIds")
  laterObservationIdsJson   String @db.Text   @map("laterObservationIds")
  state                     String   @default("ACTIVE")
  createdAt                 DateTime @default(now())

  earlierClaim MarketClaim @relation("EarlierContradictionClaim", fields: [earlierClaimId], references: [id], onDelete: Restrict)
  laterClaim   MarketClaim @relation("LaterContradictionClaim", fields: [laterClaimId], references: [id], onDelete: Restrict)

  @@unique([earlierClaimId, laterClaimId])
  @@index([tenant, claimKey, state])
}

/// Exact observation membership for a claim. This join is append-only in the
/// database so a later compiler cannot delete inconvenient evidence.
model MarketClaimEvidence {
  claimId       String
  observationId String
  role          String
  createdAt     DateTime @default(now())

  claim       MarketClaim       @relation(fields: [claimId], references: [id], onDelete: Restrict)
  observation MarketObservation @relation(fields: [observationId], references: [id], onDelete: Restrict)

  @@id([claimId, observationId])
  @@index([observationId])
}

/// Append-only Verification Court outcome, including preservation of conflicts
/// and explicit reasons for every eligibility decision.
model MarketVerificationEvent {
  id               String   @id @default(uuid())
  claimId          String
  decision         String
  reason           String @db.Text
  evaluatorVersion String
  evidenceDigest   String
  asOf             DateTime
  createdAt        DateTime @default(now())

  claim MarketClaim @relation(fields: [claimId], references: [id], onDelete: Restrict)

  @@unique([claimId, evidenceDigest])
  @@index([claimId, createdAt])
  @@index([decision, createdAt])
}

// ============================================================================
// SOVEREIGN CONTINUATION KERNEL (Slice 1) — owner mandate 2026-08-09.
//
// CANA itself must remember what must happen later. These tables are the
// durable, database-owned continuation state: a conversation ending, a model
// failing, or a machine restarting must not erase a future mission. External
// runtimes (cPanel cron via deploy/namecheap/worker.mjs, Hyperagent, Temporal,
// a laptop) may WAKE this state by invoking the tick; none of them own it.
//
// Design laws enforced by src/lib/continuation/*:
//  1. Every trigger binds purpose (reason), stop condition, budget ceiling,
//     authority ceiling and expiry — specs missing any of these are REJECTED.
//  2. A mission can never raise its own authority ceiling; child continuations
//     inherit a ceiling no higher than their creator's.
//  3. OBSERVE_ONLY work may auto-fire; EFFECTFUL work is born PENDING_APPROVAL
//     and only an explicit approval arms it.
//  4. Firing is exactly-once under concurrent ticks (conditional-claim UPDATE,
//     same adjudication pattern as DemandCreditEntry's unique constraint).
//  5. Receipts are append-only and hash-chained per mission (same pattern as
//     the demand-credit ledger) so continuation history is tamper-evident.
//
// Precedent followed: like DemandCreditEntry, these models use plain string
// refs (no cross-model @relation) so their DDL stands alone on bare
// PostgreSQL — the kernel must not acquire a PostGIS dependency.
// ============================================================================

/// A durable unit of intent: what CANA is doing, waiting for, or must do later.
model ContinuationMission {
  id                   String    @id @default(uuid())
  tenant               String
  /// Why this mission exists — human-legible, required.
  purpose              String
  /// Provenance of creation: OWNER_REQUEST | TRACK_A_ASK | TRACK_B_PROVENANCE | SELF_GENERATED:<system>
  createdFrom          String
  /// PROPOSED | ACTIVE | WAITING | COMPLETED | ABANDONED | EXPIRED
  status               String    @default("ACTIVE")
  /// OBSERVE_ONLY | PROPOSE_ONLY | EFFECTFUL_WITH_APPROVAL — never self-raised.
  authorityCeiling     String
  /// Hard spend ceiling for everything this mission wakes. Cents.
  budgetCentsMax       Int
  spentCents           Int       @default(0)
  /// Explicit condition under which this mission stops existing. Required.
  stopCondition        String
  expiresAt            DateTime?
  /// Opaque refs into canonical state; JSON strings, validated by app code.
  stateRef             String?
  executionGenomeRef   String?
  evidenceRequirements String?
  latestReceiptId      String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([tenant, status])
  @@index([status, expiresAt])
}

/// A durable reason to wake a mission later. NOT a cron row: firing resolves
/// through mission semantics (verified state -> authority -> evidence -> receipt).
model ContinuationTrigger {
  id                   String    @id @default(uuid())
  missionId            String
  tenant               String
  /// SCHEDULED | EVENT | CONDITION_WATCH | DEPENDENCY | FOLLOW_UP | REVALIDATION | LEARNING
  triggerType          String
  /// Why this trigger exists — required, human-legible.
  reason               String
  /// What created it (owner intent, Track A opportunity, Track B receipt, self-generated system).
  createdFrom          String
  /// PENDING_APPROVAL | ARMED | FIRED | EXPIRED | CANCELLED | REJECTED
  status               String    @default("ARMED")
  /// SCHEDULED / FOLLOW_UP / REVALIDATION / LEARNING: earliest firing time.
  nextEligibleAt       DateTime?
  /// EVENT: the event key that fires it (e.g. "pr.merged:CannabisWorldHoldings/CANA#29").
  eventKey             String?
  /// CONDITION_WATCH: opaque condition ref resolved by a registered evaluator.
  conditionRef         String?
  /// DEPENDENCY: fires only after this trigger has FIRED.
  dependsOnTriggerId   String?
  /// OBSERVE_ONLY | PROPOSE_ONLY | EFFECTFUL_WITH_APPROVAL — <= mission ceiling.
  authorityCeiling     String
  budgetCentsMax       Int
  /// Explicit stop condition. Required — no unbounded recurring work.
  stopCondition        String
  evidenceRequirements String?
  /// JSON: { kind: "RESCHEDULE", intervalMs, remaining } — bounded recurrence.
  continuationPolicy   String?
  retryPolicy          String?
  /// Hard expiry. Required. An expired trigger NEVER fires.
  expiresAt            DateTime
  firedAt              DateTime?
  latestReceiptId      String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([status, nextEligibleAt])
  @@index([status, eventKey])
  @@index([missionId])
  @@index([tenant, status])
}

/// Append-only, hash-chained record of what the continuation kernel actually
/// did. The receipt IS the truth of firing; status fields are projections.
model ContinuationReceipt {
  /// Monotonic position in the per-mission chain.
  seq        Int
  id         String   @id @default(uuid())
  missionId  String
  triggerId  String?
  /// The tick invocation that produced this receipt.
  tickId     String
  /// FIRED | EXPIRED | REJECTED | APPROVED | RESCHEDULED | REFLECTED | CONSUMER_FAILED | MISSION_COMPLETED | MISSION_ABANDONED
  action     String
  detail     String?
  /// JSON evidence payload bound at write time.
  evidence   String? @db.Text
  /// Chain integrity (pattern: DemandCreditEntry).
  prevHash   String
  entryHash  String   @unique
  recordedAt DateTime @default(now())

  /// One trigger-scoped receipt per (trigger, tick, action).
  @@unique([triggerId, tickId, action])
  @@unique([missionId, seq])
  @@index([missionId, recordedAt])
}

/// Track A: a merchant-actionable opportunity derived from the same evidence
/// that answered a customer intent. Claims about value default to UNKNOWN.
model Opportunity {
  id                 String   @id @default(uuid())
  tenant             String
  /// Stable tenant-scoped semantic identity; never raw customer language.
  dedupeKey          String
  /// MARKET_GAP | MERCHANT_GAP | ... (kind vocabulary grows by evidence, not invention)
  kind               String
  /// Plain string ref, no FK (a gap opportunity may reference no retailer).
  retailerId         String?
  /// JSON: the evidence refs that justify this opportunity. Required.
  evidence           String @db.Text
  /// JSON: what was actually observed (query, filters, counts, timestamps).
  observedState      String @db.Text
  /// What the customer/market signal was.
  signal             String
  hypothesizedValue  String?
  confidence         Float?
  recommendedAction  String
  /// Authority required to act on it — acting is NEVER automatic.
  requiredAuthority  String
  estimatedCostCents Int?
  risk               String?
  rollback           String?
  measurementPlan    String
  /// UNKNOWN | HYPOTHESIS | SUPPORTED | VERIFIED | CONTRADICTED | REFUTED | STALE
  verification       String   @default("UNKNOWN")
  /// OPEN | UNDER_REVIEW | ACTIONED | CLOSED | DISMISSED | EXPIRED
  status             String   @default("OPEN")
  followUpTriggerId  String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([tenant, dedupeKey])
  @@index([tenant, status])
  @@index([kind, verification])
}

/// Track A instrumentation: every real ask is a provenance-carrying signal.
model AskIntentSignal {
  id             String   @id @default(uuid())
  tenant         String
  /// SHA-256 identity of the minimized intent; raw customer language is not persisted.
  rawQuery       String
  /// JSON minimized Intent IR including explicit unknown dimensions, without raw text.
  intentIr       String @db.Text
  /// JSON answer summary: candidate count, unknowns surfaced, zero-state flag.
  answerSummary  String @db.Text
  candidateCount Int
  opportunityId  String?
  createdAt      DateTime @default(now())

  @@index([tenant, createdAt])
}
