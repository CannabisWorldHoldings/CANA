# ---------------------------------------------------------------------------
# CANA canonical datastore: managed PostgreSQL + PostGIS (see docs/adr/0001).
#
#   DATABASE_URL  pooled connection   - used by the running application
#   DIRECT_URL    unpooled connection - used by `prisma migrate` / introspection
#
# Both are standard PostgreSQL URLs; sslmode=require is mandatory.
# NEVER prefix these with NEXT_PUBLIC_ — that would publish database
# credentials in the browser bundle.
#
# SQLite (file:./dev.db) is no longer a supported runtime target. It stays
# readable only so pre-migration rollback snapshots can be inspected.
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://user:password@host-pooler.region.example.tech/cana?sslmode=require
DIRECT_URL=postgresql://user:password@host.region.example.tech/cana?sslmode=require

CANA_ALLOWED_HOSTS=

# Optional strong overrides for local demonstration accounts. When omitted,
# the seed generates unique credentials in the ignored .cana-local directory.
CANA_DEMO_ADMIN_PASSWORD=
CANA_DEMO_RETAILER_PASSWORD=
CANA_DEMO_CUSTOMER_PASSWORD=
